# 复制为 .env 后填写；.env 不入库
# 检测后端：local（离线，默认）| baidu（百度云人脸检测）
SP_BACKEND=local

# 摄像头编号，多摄像头时逐个试 0/1/2
SP_CAMERA_INDEX=0

# 改用视频/图片文件作为输入（无摄像头时演示用），设置后忽略 SP_CAMERA_INDEX
# SP_SOURCE=./demo.mp4

# 检测间隔（秒）
SP_DETECT_INTERVAL_S=2

# 在座判据：连续命中多少秒才算在座 / 连续落空多少秒才算离座
SP_PRESENT_AFTER_S=4
SP_ABSENT_AFTER_S=6

# 人脸框至少占整帧面积的比例，低于此值视为远处的脸（海报、路人、室友）
SP_MIN_FACE_AREA=0.02

# 交互证据：读取系统「上次键鼠输入距今多少秒」，只取时长不取内容
# 关闭后只有视觉判定，在座即视为有交互
SP_TRACK_INPUT=1
SP_ACTIVITY_IDLE_S=60

# SQLite 落盘位置（窗口与 --report 共用）
# SP_DB_PATH=./data/presence.db

# 仅在 SP_BACKEND=baidu 时必填：https://console.bce.baidu.com/ai/#/ai/face/app/list
SP_BAIDU_API_KEY=
SP_BAIDU_SECRET_KEY=
