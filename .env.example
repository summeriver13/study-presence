# 复制为 .env 后填写；.env 不入库
# 检测后端：local（离线，默认）| baidu（百度云人脸检测）
SP_BACKEND=local

# 摄像头编号，多摄像头时逐个试 0/1/2
SP_CAMERA_INDEX=0

# 改用视频/图片文件作为输入（无摄像头时演示用），设置后忽略 SP_CAMERA_INDEX
# SP_SOURCE=./demo.mp4

# 检测间隔（秒）
SP_DETECT_INTERVAL_S=2

# 连续命中多少帧才算在座 / 连续落空多少帧才算离座
SP_PRESENT_AFTER=2
SP_ABSENT_AFTER=3

# 仅在 SP_BACKEND=baidu 时必填：https://console.bce.baidu.com/ai/#/ai/face/app/list
SP_BAIDU_API_KEY=
SP_BAIDU_SECRET_KEY=
